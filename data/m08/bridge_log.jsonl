{"hop": "sandbox-host", "from": "host", "to": "sandbox", "kind": "notification", "method": "ui/notifications/sandbox-resource-ready", "msg": {"jsonrpc": "2.0", "method": "ui/notifications/sandbox-resource-ready", "params": {"html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Fernhill order board</title>\n<style>\n  /* Fallbacks first. The host can override any of these through hostContext.styles.variables. */\n  :root {\n    --color-background-primary: #fffdf9;\n    --color-background-secondary: #f6f0e7;\n    --color-text-primary: #2b1f17;\n    --color-text-secondary: #7a6a5d;\n    --color-border-primary: #e9dfd2;\n    --font-sans: ui-sans-serif, -apple-system, \"Segoe UI\", system-ui, sans-serif;\n    --font-mono: ui-monospace, \"SF Mono\", Menlo, monospace;\n    --border-radius-md: 10px;\n    --fh-brown: #4a3326;\n    --fh-making: #b26b12;   --fh-making-bg: #fdf1df;\n    --fh-ready: #1f7a55;    --fh-ready-bg: #e3f4ec;\n    --fh-done: #8c8178;     --fh-done-bg: #f1ece6;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; background: var(--color-background-primary); color: var(--color-text-primary);\n               font-family: var(--font-sans); font-size: 15px; -webkit-font-smoothing: antialiased; }\n  .board { padding: 14px 18px 12px; }\n  header { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }\n  .mark { width: 34px; height: 34px; border-radius: 9px; background: var(--fh-brown); display: grid; place-items: center; }\n  .title { font-weight: 650; font-size: 17px; letter-spacing: -0.01em; }\n  .sub { color: var(--color-text-secondary); font-size: 13px; margin-top: 1px; }\n  .counts { margin-left: auto; display: flex; gap: 8px; }\n  .count { font-size: 13px; padding: 5px 10px; border-radius: 999px; background: var(--color-background-secondary);\n           color: var(--color-text-secondary); font-variant-numeric: tabular-nums; }\n  .count b { color: var(--color-text-primary); font-weight: 650; }\n  ul { list-style: none; margin: 0; padding: 0; border: 1px solid var(--color-border-primary);\n       border-radius: var(--border-radius-md); overflow: hidden; }\n  li { display: grid; grid-template-columns: 74px 1fr auto 92px 108px; align-items: center; gap: 12px;\n       padding: 7px 14px; border-top: 1px solid var(--color-border-primary); transition: background .5s; }\n  li:first-child { border-top: 0; }\n  li.flash { background: #eaf7f0; }\n  .id { font-family: var(--font-mono); font-size: 13px; color: var(--color-text-secondary); }\n  .line { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .who { font-weight: 600; }\n  .items { color: var(--color-text-secondary); font-size: 13px; }\n  .total { font-variant-numeric: tabular-nums; font-size: 14px; text-align: right; }\n  .pill { justify-self: start; font-size: 12px; font-weight: 600; padding: 4px 9px; border-radius: 999px; }\n  .pill.making { color: var(--fh-making); background: var(--fh-making-bg); }\n  .pill.ready  { color: var(--fh-ready);  background: var(--fh-ready-bg); }\n  .pill.done   { color: var(--fh-done);   background: var(--fh-done-bg); }\n  li.is-done .who, li.is-done .items, li.is-done .total { color: var(--fh-done); }\n  button { font: inherit; font-size: 13px; font-weight: 600; border-radius: 8px; padding: 5px 0; width: 100%;\n           border: 1px solid var(--fh-brown); background: var(--fh-brown); color: #fff; cursor: pointer; }\n  button:hover { filter: brightness(1.12); }\n  button:disabled { cursor: default; filter: none; }\n  button.saving { background: #fff; color: var(--fh-brown); }\n  .check { justify-self: stretch; text-align: center; color: var(--fh-done); font-size: 13px; }\n  .skel { height: 12px; border-radius: 6px; background: linear-gradient(90deg, #f1ebe3 0%, #f8f3ec 50%, #f1ebe3 100%);\n          background-size: 200% 100%; animation: shimmer 1.2s infinite linear; }\n  @keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }\n  footer { display: flex; justify-content: space-between; margin-top: 10px; font-size: 12px; color: var(--color-text-secondary); }\n  footer code { font-family: var(--font-mono); font-size: 11.5px; }\n  .toast { position: fixed; left: 50%; bottom: 14px; transform: translate(-50%, 20px); opacity: 0;\n           background: var(--color-text-primary); color: #fff; font-size: 13px; padding: 8px 14px; border-radius: 8px;\n           transition: all .25s; pointer-events: none; white-space: nowrap; }\n  .toast.show { opacity: 1; transform: translate(-50%, 0); }\n  .toast.warn { background: #9b2c2c; }\n</style>\n</head>\n<body>\n<div class=\"board\">\n  <header>\n    <div class=\"mark\" aria-hidden=\"true\">\n      <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><ellipse cx=\"12\" cy=\"12\" rx=\"7\" ry=\"9.5\" transform=\"rotate(35 12 12)\" fill=\"#f3e3cf\"/><path d=\"M8.2 18.4c3.4-2.6 4.6-8.4 7.6-12.8\" stroke=\"#4a3326\" stroke-width=\"1.7\" stroke-linecap=\"round\"/></svg>\n    </div>\n    <div>\n      <div class=\"title\">Fernhill Coffee · Order board</div>\n      <div class=\"sub\" id=\"sub\">Waiting for the host…</div>\n    </div>\n    <div class=\"counts\">\n      <span class=\"count\"><b id=\"n-open\">–</b> open</span>\n      <span class=\"count\"><b id=\"n-done\">–</b> done</span>\n    </div>\n  </header>\n  <ul id=\"list\"></ul>\n  <footer>\n    <span>Data: <code>show_order_board</code></span>\n    <span>Button: <code>tools/call mark_order_done</code> through the host</span>\n  </footer>\n</div>\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\n// The View talks to the host with JSON-RPC 2.0 over postMessage. No SDK, no network access.\nconst PROTOCOL = \"2026-01-26\";\nlet nextId = 1;\nconst pending = new Map();\nlet orders = [];\nlet rowOrder = [];   // fixed when the result arrives, so a row does not jump when its status changes\n\nfunction send(msg) { window.parent.postMessage(msg, \"*\"); }\nfunction request(method, params) {\n  const id = nextId++;\n  send({ jsonrpc: \"2.0\", id, method, params });\n  return new Promise((resolve, reject) => pending.set(id, { resolve, reject }));\n}\nfunction notify(method, params) { send({ jsonrpc: \"2.0\", method, params }); }\n\nwindow.addEventListener(\"message\", (event) => {\n  if (event.source !== window.parent) return;\n  const m = event.data;\n  if (!m || m.jsonrpc !== \"2.0\") return;\n  if (m.id !== undefined && m.method === undefined) {            // a response to one of our requests\n    const p = pending.get(m.id);\n    if (p) { pending.delete(m.id); m.error ? p.reject(m.error) : p.resolve(m.result); }\n    return;\n  }\n  switch (m.method) {\n    case \"ui/notifications/tool-input\":   showLoading(m.params.arguments); break;\n    case \"ui/notifications/tool-result\":  showResult(m.params); break;\n    case \"ui/notifications/tool-cancelled\": setSub(\"The tool call was cancelled: \" + m.params.reason); break;\n    case \"ui/notifications/host-context-changed\": applyHostContext(m.params); break;\n    case \"ui/resource-teardown\": send({ jsonrpc: \"2.0\", id: m.id, result: {} }); break;\n    case \"ping\": send({ jsonrpc: \"2.0\", id: m.id, result: {} }); break;\n  }\n});\n\nfunction applyHostContext(ctx) {\n  const vars = ctx && ctx.styles && ctx.styles.variables;\n  if (vars) for (const [k, v] of Object.entries(vars)) if (v) document.documentElement.style.setProperty(k, v);\n  if (ctx && ctx.theme) document.documentElement.dataset.theme = ctx.theme;\n}\nfunction setSub(text) { document.getElementById(\"sub\").textContent = text; }\n\nfunction showLoading(args) {\n  setSub(\"Loading orders…\");\n  const list = document.getElementById(\"list\");\n  list.innerHTML = \"\";\n  for (let i = 0; i < 5; i++) {\n    const li = document.createElement(\"li\");\n    li.innerHTML = '<div class=\"skel\" style=\"width:52px\"></div><div><div class=\"skel\" style=\"width:' + (160 + i * 31) + 'px\"></div></div><div class=\"skel\" style=\"width:56px\"></div>' +\n      '<div class=\"skel\" style=\"width:44px;justify-self:end\"></div><div class=\"skel\" style=\"height:26px\"></div>';\n    list.appendChild(li);\n  }\n}\n\nfunction showResult(result) {\n  const data = result.structuredContent || {};\n  orders = data.orders || [];\n  rowOrder = [...orders].sort((a, b) => RANK[a.status] - RANK[b.status] || a.order_id.localeCompare(b.order_id)).map(o => o.order_id);\n  setSub(data.day ? data.day + \" · \" + orders.length + \" orders\" : orders.length + \" orders\");\n  render();\n}\n\nconst RANK = { ready: 0, making: 1, done: 2 };\nfunction render(flashId) {\n  const list = document.getElementById(\"list\");\n  list.innerHTML = \"\";\n  const sorted = rowOrder.map(id => orders.find(o => o.order_id === id)).filter(Boolean);\n  for (const o of sorted) {\n    const li = document.createElement(\"li\");\n    li.dataset.id = o.order_id;\n    if (o.status === \"done\") li.classList.add(\"is-done\");\n    if (o.order_id === flashId) li.classList.add(\"flash\");\n    li.innerHTML =\n      '<span class=\"id\">' + o.order_id + '</span>' +\n      '<div class=\"line\"><span class=\"who\">' + esc(o.name) + '</span><span class=\"items\"> · ' + esc(o.items.join(\" · \")) + ' · ' + o.placed + '</span></div>' +\n      '<span class=\"pill ' + o.status + '\">' + label(o.status) + '</span>' +\n      '<span class=\"total\">$' + o.total.toFixed(2) + '</span>' +\n      (o.status === \"done\" ? '<span class=\"check\">✓ Done</span>'\n                           : '<button data-done=\"' + o.order_id + '\">Mark done</button>');\n    list.appendChild(li);\n  }\n  document.getElementById(\"n-open\").textContent = orders.filter(o => o.status !== \"done\").length;\n  document.getElementById(\"n-done\").textContent = orders.filter(o => o.status === \"done\").length;\n  if (flashId) setTimeout(() => { const el = list.querySelector('[data-id=\"' + flashId + '\"]'); el && el.classList.remove(\"flash\"); }, 1600);\n}\nfunction label(s) { return s === \"making\" ? \"Making\" : s === \"ready\" ? \"Ready\" : \"Done\"; }\nfunction esc(s) { return String(s).replace(/[&<>\"]/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\" }[c])); }\n\nlet toastTimer;\nfunction toast(text, warn) {\n  const t = document.getElementById(\"toast\");\n  t.textContent = text; t.className = \"toast show\" + (warn ? \" warn\" : \"\");\n  clearTimeout(toastTimer); toastTimer = setTimeout(() => t.className = \"toast\", 2600);\n}\n\ndocument.getElementById(\"list\").addEventListener(\"click\", async (event) => {\n  const btn = event.target.closest(\"button[data-done]\");\n  if (!btn) return;\n  const id = btn.dataset.done;\n  btn.disabled = true; btn.classList.add(\"saving\"); btn.textContent = \"Saving…\";\n  try {\n    // The button does not change the page by itself. It asks the host to run a server tool.\n    const result = await request(\"tools/call\", { name: \"mark_order_done\", arguments: { order_id: id } });\n    if (result.isError) throw { message: result.content && result.content[0] ? result.content[0].text : \"Tool error\" };\n    const updated = result.structuredContent.order;\n    orders = orders.map(o => o.order_id === updated.order_id ? updated : o);\n    render(updated.order_id);\n    toast(updated.order_id + \" marked done · saved on the server\");\n    const open = orders.filter(o => o.status !== \"done\").length;\n    // Tell the model what the person did, for the next turn.\n    await request(\"ui/update-model-context\", {\n      content: [{ type: \"text\", text: \"The person marked order \" + updated.order_id + \" (\" + updated.name +\n                  \") done on the order board. Open orders now: \" + open + \".\" }],\n    });\n  } catch (err) {\n    btn.disabled = false; btn.classList.remove(\"saving\"); btn.textContent = \"Mark done\";\n    toast(\"Not done: \" + (err && err.message ? err.message : String(err)), true);\n  }\n});\n\n(async () => {\n  const init = await request(\"ui/initialize\", {\n    appInfo: { name: \"fernhill-order-board\", version: \"1.0.0\" },\n    appCapabilities: { availableDisplayModes: [\"inline\"] },\n    protocolVersion: PROTOCOL,\n  });\n  applyHostContext(init.hostContext);\n  setSub(\"Connected to \" + init.hostInfo.name);\n  notify(\"ui/notifications/initialized\", {});\n  // Report the content size so the host can fit the frame to it (flexible height).\n  let last = \"\";\n  new ResizeObserver(() => {\n    const el = document.querySelector(\".board\");\n    const size = { width: Math.ceil(el.scrollWidth), height: Math.ceil(el.scrollHeight) };\n    if (JSON.stringify(size) === last) return;\n    last = JSON.stringify(size);\n    notify(\"ui/notifications/size-changed\", size);\n  }).observe(document.querySelector(\".board\"));\n})();\n</script>\n</body>\n</html>\n"}}, "seq": 13, "t_ms": 2138, "wall": "2026-11-05T05:41:38.355Z"}
