{"hop": "host-server", "from": "server", "to": "host", "kind": "response", "method": "tools/list", "id": 2, "http_status": 200, "server_ms": 0.97, "msg": {"jsonrpc": "2.0", "id": 2, "result": {"cacheScope": "private", "resultType": "complete", "tools": [{"_meta": {"ui": {"resourceUri": "ui://fernhill/order-board", "visibility": ["model", "app"]}}, "annotations": {"readOnlyHint": true}, "description": "Show today's Fernhill orders on an interactive order board. The barista can mark orders done on the board.", "inputSchema": {"type": "object", "properties": {}, "title": "show_order_boardArguments"}, "name": "show_order_board", "outputSchema": {"$defs": {"OrderRow": {"properties": {"order_id": {"title": "Order Id", "type": "string"}, "name": {"title": "Name", "type": "string"}, "items": {"items": {"type": "string"}, "title": "Items", "type": "array"}, "total": {"title": "Total", "type": "number"}, "status": {"title": "Status", "type": "string"}, "placed": {"title": "Placed", "type": "string"}}, "required": ["order_id", "name", "items", "total", "status", "placed"], "title": "OrderRow", "type": "object"}}, "properties": {"day": {"title": "Day", "type": "string"}, "orders": {"items": {"$ref": "#/$defs/OrderRow"}, "title": "Orders", "type": "array"}}, "required": ["day", "orders"], "title": "Board", "type": "object"}, "title": "Order board"}, {"_meta": {"ui": {"resourceUri": "ui://fernhill/order-board", "visibility": ["app"]}}, "annotations": {"destructiveHint": false, "idempotentHint": true, "readOnlyHint": false}, "description": "Mark one order as done (the customer has the drink).", "inputSchema": {"type": "object", "properties": {"order_id": {"title": "Order Id", "type": "string"}}, "required": ["order_id"], "title": "mark_order_doneArguments"}, "name": "mark_order_done", "outputSchema": {"$defs": {"OrderRow": {"properties": {"order_id": {"title": "Order Id", "type": "string"}, "name": {"title": "Name", "type": "string"}, "items": {"items": {"type": "string"}, "title"