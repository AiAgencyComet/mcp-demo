[
 {
  "name": "fernhill__get_menu",
  "description": "Return every item on the Fernhill menu with its price and sizes.",
  "input_schema": {
   "type": "object",
   "properties": {},
   "title": "get_menuArguments"
  }
 },
 {
  "name": "fernhill__place_order",
  "description": "Place a new order. Returns an order_id. Use that order_id in later calls.",
  "input_schema": {
   "type": "object",
   "$defs": {
    "Delivery": {
     "properties": {
      "kind": {
       "const": "delivery",
       "title": "Kind",
       "type": "string"
      },
      "address": {
       "title": "Address",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "address"
     ],
     "title": "Delivery",
     "type": "object"
    },
    "Item": {
     "properties": {
      "drink": {
       "description": "A drink name from get_menu",
       "title": "Drink",
       "type": "string"
      },
      "size": {
       "title": "Size",
       "type": "string"
      },
      "milk": {
       "default": "whole",
       "enum": [
        "whole",
        "oat",
        "none"
       ],
       "title": "Milk",
       "type": "string"
      }
     },
     "required": [
      "drink",
      "size"
     ],
     "title": "Item",
     "type": "object"
    },
    "Pickup": {
     "properties": {
      "kind": {
       "const": "pickup",
       "title": "Kind",
       "type": "string"
      },
      "name": {
       "description": "Name to call at the counter",
       "title": "Name",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "name"
     ],
     "title": "Pickup",
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/Item"
     },
     "title": "Items",
     "type": "array"
    },
    "handoff": {
     "anyOf": [
      {
       "$ref": "#/$defs/Pickup"
      },
      {
       "$ref": "#/$defs/Delivery"
      }
     ],
     "title": "Handoff"
    }
   },
   "required": [
    "items",
    "handoff"
   ],
   "title": "place_orderArguments"
  }
 },
 {
  "name": "fernhill__order_status",
  "description": "Return the status of one order.",
  "input_schema": {
   "type": "object",
   "properties": {
    "order_id": {
     "title": "Order Id",
     "type": "string"
    }
   },
   "required": [
    "order_id"
   ],
   "title": "order_statusArguments"
  }
 },
 {
  "name": "fernhill__refund",
  "description": "Refund one order. The person must confirm first.",
  "input_schema": {
   "type": "object",
   "properties": {
    "order_id": {
     "title": "Order Id",
     "type": "string"
    }
   },
   "required": [
    "order_id"
   ],
   "title": "refundArguments"
  }
 }
]