[
 {
  "name": "get_menu",
  "description": "Return every item on the Fernhill menu with its price and sizes.",
  "inputSchema": {
   "type": "object",
   "properties": {},
   "title": "get_menuArguments"
  },
  "outputSchema": {
   "$defs": {
    "MenuItem": {
     "properties": {
      "drink": {
       "title": "Drink",
       "type": "string"
      },
      "price": {
       "description": "Price in US dollars",
       "title": "Price",
       "type": "number"
      },
      "sizes": {
       "items": {
        "type": "string"
       },
       "title": "Sizes",
       "type": "array"
      }
     },
     "required": [
      "drink",
      "price",
      "sizes"
     ],
     "title": "MenuItem",
     "type": "object"
    }
   },
   "properties": {
    "result": {
     "items": {
      "$ref": "#/$defs/MenuItem"
     },
     "title": "Result",
     "type": "array"
    }
   },
   "required": [
    "result"
   ],
   "title": "get_menuOutput",
   "type": "object"
  }
 },
 {
  "name": "place_order",
  "description": "Place a new order. Returns an order_id. Use that order_id in later calls.",
  "inputSchema": {
   "type": "object",
   "$defs": {
    "Delivery": {
     "properties": {
      "kind": {
       "const": "delivery",
       "title": "Kind",
       "type": "string"
      },
      "address": {
       "title": "Address",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "address"
     ],
     "title": "Delivery",
     "type": "object"
    },
    "Item": {
     "properties": {
      "drink": {
       "description": "Name of one menu item from get_menu, a drink or a food item, for example 'latte' or 'oat cookie'",
       "title": "Drink",
       "type": "string"
      },
      "size": {
       "description": "A size of that item from get_menu, for example 'small', 'large', 'single', 'double', or 'one' for food",
       "title": "Size",
       "type": "string"
      },
      "milk": {
       "default": "whole",
       "enum": [
        "whole",
        "oat",
        "none"
       ],
       "title": "Milk",
       "type": "string"
      }
     },
     "required": [
      "drink",
      "size"
     ],
     "title": "Item",
     "type": "object"
    },
    "Pickup": {
     "properties": {
      "kind": {
       "const": "pickup",
       "title": "Kind",
       "type": "string"
      },
      "name": {
       "description": "Name to call at the counter",
       "title": "Name",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "name"
     ],
     "title": "Pickup",
     "type": "object"
    }
   },
   "properties": {
    "items": {
     "items": {
      "$ref": "#/$defs/Item"
     },
     "title": "Items",
     "type": "array"
    },
    "handoff": {
     "anyOf": [
      {
       "$ref": "#/$defs/Pickup"
      },
      {
       "$ref": "#/$defs/Delivery"
      }
     ],
     "title": "Handoff"
    },
    "note": {
     "type": "string",
     "default": "",
     "description": "A note for the barista"
    }
   },
   "required": [
    "items",
    "handoff"
   ],
   "title": "place_orderArguments"
  },
  "outputSchema": {
   "properties": {
    "order_id": {
     "description": "Give this ID to order_status and refund",
     "title": "Order Id",
     "type": "string"
    },
    "total": {
     "title": "Total",
     "type": "number"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "order_id",
    "total",
    "status"
   ],
   "title": "Order",
   "type": "object"
  }
 },
 {
  "name": "order_status",
  "description": "Return the status of one order.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "order_id": {
     "title": "Order Id",
     "type": "string"
    }
   },
   "required": [
    "order_id"
   ],
   "title": "order_statusArguments"
  },
  "outputSchema": {
   "properties": {
    "order_id": {
     "description": "Give this ID to order_status and refund",
     "title": "Order Id",
     "type": "string"
    },
    "total": {
     "title": "Total",
     "type": "number"
    },
    "status": {
     "title": "Status",
     "type": "string"
    }
   },
   "required": [
    "order_id",
    "total",
    "status"
   ],
   "title": "Order",
   "type": "object"
  }
 },
 {
  "name": "refund",
  "description": "Refund one order: give the money back to the customer. The server asks the person to confirm, so call this tool at once.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "order_id": {
     "title": "Order Id",
     "type": "string"
    }
   },
   "required": [
    "order_id"
   ],
   "title": "refundArguments"
  },
  "outputSchema": {
   "properties": {
    "result": {
     "title": "Result",
     "type": "string"
    }
   },
   "required": [
    "result"
   ],
   "title": "refundOutput",
   "type": "object"
  }
 },
 {
  "name": "get_stock",
  "description": "Return how many units of one stock item are left.",
  "inputSchema": {
   "type": "object",
   "properties": {
    "item": {
     "type": "string"
    }
   },
   "required": [
    "item"
   ]
  }
 }
]