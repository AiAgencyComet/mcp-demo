[
 {
  "name": "fernhill__mn_list",
  "description": "Tool.",
  "input_schema": {
   "type": "object",
   "properties": {},
   "title": "mn_listArguments"
  }
 },
 {
  "name": "fernhill__po_create",
  "description": "Tool.",
  "input_schema": {
   "type": "object",
   "$defs": {
    "Delivery": {
     "properties": {
      "kind": {
       "const": "delivery",
       "title": "Kind",
       "type": "string"
      },
      "address": {
       "title": "Address",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "address"
     ],
     "title": "Delivery",
     "type": "object"
    },
    "Item": {
     "properties": {
      "drink": {
       "title": "Drink",
       "type": "string"
      },
      "size": {
       "title": "Size",
       "type": "string"
      },
      "milk": {
       "default": "whole",
       "enum": [
        "whole",
        "oat",
        "none"
       ],
       "title": "Milk",
       "type": "string"
      }
     },
     "required": [
      "drink",
      "size"
     ],
     "title": "Item",
     "type": "object"
    },
    "Pickup": {
     "properties": {
      "kind": {
       "const": "pickup",
       "title": "Kind",
       "type": "string"
      },
      "name": {
       "title": "Name",
       "type": "string"
      }
     },
     "required": [
      "kind",
      "name"
     ],
     "title": "Pickup",
     "type": "object"
    }
   },
   "properties": {
    "p1": {
     "items": {
      "$ref": "#/$defs/Item"
     },
     "title": "P1",
     "type": "array"
    },
    "p2": {
     "anyOf": [
      {
       "$ref": "#/$defs/Pickup"
      },
      {
       "$ref": "#/$defs/Delivery"
      }
     ],
     "title": "P2"
    }
   },
   "required": [
    "p1",
    "p2"
   ],
   "title": "po_createArguments"
  }
 },
 {
  "name": "fernhill__po_get",
  "description": "Tool.",
  "input_schema": {
   "type": "object",
   "properties": {
    "p1": {
     "title": "P1",
     "type": "string"
    }
   },
   "required": [
    "p1"
   ],
   "title": "po_getArguments"
  }
 },
